{
  "name": "speechready",
  "version": "0.1.0-dev.0",
  "description": "Prepare text for text-to-speech: clean LLM output, verbalize ambiguous tokens, compile pauses to each provider's syntax, chunk under model limits.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "license": "MIT",
  "author": "Berker Batur",
  "repository": { "type": "git", "url": "https://github.com/berkerbatur/speechready", "directory": "js" },
  "homepage": "https://github.com/berkerbatur/speechready",
  "keywords": ["tts", "text-to-speech", "text-normalization", "ssml", "voice-agents"],
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node scripts/build-profiles.mjs && tsc -p tsconfig.json",
    "test": "npm run build && node --test test/spec.test.mjs test/package.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.6.3",
    "yaml": "^2.6.1"
  }
}
